# ---------- Server ----------
PORT=3000
NODE_ENV=development
# Public base URL Twilio will call (e.g. your ngrok / deploy URL)
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Auth ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300

# ---------- Supabase (Project Settings > API) ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- WhatsApp provider ----------
# WHATSAPP_MOCK=true -> no real messages (logs instead). false -> send for real.
WHATSAPP_MOCK=true
# Which provider delivers WhatsApp: "twilio" or "meta".
WHATSAPP_PROVIDER=twilio

# ---------- Twilio WhatsApp (used when WHATSAPP_PROVIDER=twilio) ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- Meta WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta) ----------
# From: developers.facebook.com > your app > WhatsApp > API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Any string you choose — must match the "Verify token" in Meta > Configuration.
META_VERIFY_TOKEN=oasis_verify_2026
META_GRAPH_VERSION=v21.0
# App secret (Meta app > Settings > Basic) — verifies inbound webhook signatures.
# Leave blank to skip verification (NOT recommended in production).
META_APP_SECRET=

# ---------- Routing of internal alerts ----------
# Where "new request" alerts go (Service Manager WhatsApp, E.164).
# Active managers in the users table also receive alerts automatically.
MANAGER_WHATSAPP=+91XXXXXXXXXX
# Default country code prepended to bare local numbers entered by customers
DEFAULT_COUNTRY_CODE=+91

# ---------- Frontend ----------
CORS_ORIGIN=http://localhost:5173

# ---------- WhatsApp agent (Groq) ----------
# The WhatsApp intake runs a Groq tool-calling agent (services/agent/). It needs a
# GROQ_API_KEY to work. Get a FREE key at console.groq.com.
# You can set MULTIPLE keys, comma-separated — the agent rotates to the next key
# when one hits its daily token cap:  GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback / alternate LLM (OpenRouter) — same OpenAI-shaped API, same model family.
# Use a PAID model here (drop any ":free" suffix); the free routes are queued and
# slow. Credits: openrouter.ai/credits
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Which provider the agent tries FIRST: "groq" (default) or "openrouter".
# Groq is faster, but on its FREE 8K-tokens/minute tier every intake message
# blows the budget mid-way and pays a 429 + backoff before falling through. While
# Groq is unpaid, set this to "openrouter" to skip that per-message tax. Flip back
# to "groq" once the Groq Developer (paid) tier is active on the account.
LLM_PRIMARY=openrouter

# ---------- Agent timing ----------
# Hard ceiling on one customer message inside the agent loop. On expiry the bot
# sends a holding reply instead of leaving the customer waiting.
AGENT_DEADLINE_MS=30000
# Per-request timeout handed to the LLM provider.
AGENT_CALL_TIMEOUT_MS=12000
# Pause after the customer's LAST message before the bot replies (batches
# rapid-fire messages into one reply).
BOT_REPLY_DELAY_MS=1200
# Extra "typing" pause before sending. 0 = off; the agent loop is already slow
# enough that this only added to the wait.
BOT_SEND_DELAY_MS=0

# ---------- Dashboard inbox ----------
# Rolling window for the chat-list query. The inbox is polled every 10s by every
# open dashboard; without a window it scanned thousands of message rows each time.
# Threads silent for longer than this drop off the list — widen if needed.
INBOX_WINDOW_DAYS=90

# FAQ / company-info flow (Flow 3). false (default) = agent deflects general
# questions ("our team will confirm") instead of quoting areas/timings/AMC/pricing.
# Set true once the values in services/agent/knowledge.js are verified.
FAQ_ENABLED=false
